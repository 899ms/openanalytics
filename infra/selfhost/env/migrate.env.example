# The one-shot migration container.
#
# It runs `packages/postgres/dist/cli.js` and then
# `packages/clickhouse/dist/cli.js` — compiled output, which is why it runs from
# the BUILT image and not from a checkout. Both runners keep a ledger and apply
# only what is pending, so re-running is the normal upgrade path.
#
# This container holds the two DDL credentials and no service does. It is not
# validated against the per-service secret boundary (the CLIs read process.env
# directly), which is exactly why it is a separate container that exits.

# --- Postgres ---------------------------------------------------------------
# POSTGRES_MIGRATION_URL is preferred over DATABASE_URL so the application user
# can be a different, non-DDL role later. They are the same here.
POSTGRES_MIGRATION_URL=postgres://openanalytics:{{POSTGRES_PASSWORD}}@postgres:5432/openanalytics
# Postgres on Neon (recommended managed option — ../NEON.md): the DIRECT
# connection string, pooling off, so no `-pooler` in the host. The same string
# goes in api.env, collector.env, worker.env and migrate.env.
#POSTGRES_MIGRATION_URL=postgresql://neondb_owner:<password>@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- ClickHouse -------------------------------------------------------------
# NOTE THE VARIABLE NAME: the ClickHouse CLI reads CLICKHOUSE_DATABASE, while
# the worker and the gateway read CLICKHOUSE_DB. Both default to `analytics`, so
# the mismatch is invisible until someone renames the database in one place.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_MIGRATION_USER=oa_migration
CLICKHOUSE_MIGRATION_PASSWORD={{CLICKHOUSE_MIGRATION_PASSWORD}}

# Appears in the migration runner's structured logs.
ENVIRONMENT=production
