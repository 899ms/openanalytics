# Postgres — the control plane store: users, sites, keys, event definitions,
# sharing, the job runner and the outbox.
#
# These three values also appear inside DATABASE_URL in api.env, collector.env,
# worker.env and migrate.env. `./generate-secrets.sh` writes all of them from
# one generated password; if you change it here, change it there too.
#
# With Postgres on Neon (../NEON.md) the `postgres` service does not run and
# this file is not read.
POSTGRES_USER=openanalytics
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_DB=openanalytics
